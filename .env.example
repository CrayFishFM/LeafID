# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Optional, legacy: folder where uploads used to be saved as files (default ./data).
# On start, any photos found there are moved into the database.
# DATA_DIR=./data

# Email via Hostinger Mail API (https://github.com/hostinger/mail-api-typescript-sdk).
# Without a token, emails are printed to the server log and email verification is not required.
HOSTINGER_MAIL_TOKEN=
# Optional: mailbox resource ID to send from (defaults to the first mailbox the token can manage)
HOSTINGER_MAILBOX_ID=
MAIL_FROM_NAME=LeafID

# Comma-separated emails that get the admin role (applied on sign-up and on server start)
ADMIN_EMAILS=

# MySQL connection (on Hostinger shared hosting the host is usually localhost)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=

# Discord login (https://discord.com/developers/applications → OAuth2).
# Redirect URL to add there: <BETTER_AUTH_URL>/api/auth/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
